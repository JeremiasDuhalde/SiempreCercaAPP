  <diagram name="Proceso Operativo" id="proceso-operativo">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Titulo -->
        <mxCell id="title" value="PROCESO OPERATIVO — SIEMPRE CERCA SRL" style="text;html=1;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="400" y="20" width="600" height="40" as="geometry"/>
        </mxCell>

        <!-- FASE 1: Derivacion -->
        <mxCell id="deriv" value="&lt;b&gt;DERIVACIÓN DEL PACIENTE&lt;/b&gt;&lt;br&gt;La empresa (OS/ART/prepaga)&lt;br&gt;deriva un paciente con&lt;br&gt;requerimientos de cobertura" style="shape=step;perimeter=stepPerimeter;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;size=0.1;" vertex="1" parent="1">
          <mxGeometry x="500" y="80" width="300" height="80" as="geometry"/>
        </mxCell>

        <!-- Linea -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="deriv" target="decision1" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Decision: hay prestadores? -->
        <mxCell id="decision1" value="¿Hay prestadores&lt;br&gt;disponibles en&lt;br&gt;la zona?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="570" y="200" width="160" height="120" as="geometry"/>
        </mxCell>

        <!-- SI -->
        <mxCell id="e2si" value="SÍ" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="decision1" target="cargaPaciente" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="450" y="260"/></Array>
          </mxGeometry>
        </mxCell>

        <!-- NO -->
        <mxCell id="e2no" value="NO" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="decision1" target="cargaPrestador" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="850" y="260"/></Array>
          </mxGeometry>
        </mxCell>

        <!-- Carga paciente -->
        <mxCell id="cargaPaciente" value="&lt;b&gt;CARGA DEL PACIENTE&lt;/b&gt;&lt;br&gt;&lt;hr&gt;Datos personales, DNI,&lt;br&gt;domicilio, obra social,&lt;br&gt;nro. afiliado, diagnóstico&lt;br&gt;&lt;br&gt;&lt;i&gt;Odoo: Contactos (res.partner)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="310" y="370" width="220" height="130" as="geometry"/>
        </mxCell>

        <!-- Carga prestador -->
        <mxCell id="cargaPrestador" value="&lt;b&gt;CARGA DE PRESTADORES&lt;/b&gt;&lt;br&gt;&lt;hr&gt;Datos personales, matrícula,&lt;br&gt;zona, disponibilidad&lt;br&gt;&lt;b&gt;Legajo digital:&lt;/b&gt; PDFs adjuntos&lt;br&gt;(título, matrícula, seguro)&lt;br&gt;&lt;br&gt;&lt;i&gt;Odoo: Contactos + Documentos&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="770" y="370" width="220" height="130" as="geometry"/>
        </mxCell>

        <!-- Flecha de prestador a paciente (se asocia) -->
        <mxCell id="e3" value="se asocia" style="edgeStyle=orthogonalEdgeStyle;dashed=1;" edge="1" source="cargaPrestador" target="cargaPaciente" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Linea a orden -->
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="cargaPaciente" target="orden" parent="1">
